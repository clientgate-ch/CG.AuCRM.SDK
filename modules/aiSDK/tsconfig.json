{
	"compilerOptions": {
		"outDir": "./dist/",
		"rootDir": "../",
		"noImplicitAny": false,
		"strictNullChecks": false,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"module": "es2020",
		"resolveJsonModule": true,
		"target": "es2019",
		"allowJs": true,
		"moduleResolution": "bundler",
		"sourceMap": true,
		"lib": [
			"DOM",
			"ES2019",
		],
		"types": [
			"jquery",
			"node",
			"jest"
		]
	},
	"include": [
		"./src/**/*.ts",
		"./src/**/*.d.ts",
		"../frontend/src/types/**/*.d.ts",
		"../frontend/src/types/**/*.ts"
	],
	"ts-node": {
		"files": true
	}
}
