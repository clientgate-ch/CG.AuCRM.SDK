{
	"compilerOptions": {
		"outDir": "./dist/",
		"rootDir": "./",
		"noImplicitAny": false,
		"strictNullChecks": false,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"module": "node16",
		"resolveJsonModule": true,
		"target": "es2019",
		"allowJs": true,
		"moduleResolution": "node16",
		"sourceMap": true,
		"lib": [
			"DOM",
			"ES2019",
		],
		"types": [
			"jquery",
			"node",
			"jest"
		]
	},
	"ts-node": {
		"files": true
	}
}